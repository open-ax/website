{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration-schema.json",
  "name": "openax",
  "compatibility_date": "2026-09-30",

  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }

  // Pin a custom domain with a route, or attach it in the dashboard. Prefer the
  // dashboard: it keeps DNS and the Worker binding together and survives a
  // rename of `name` above.
  //
  // "routes": [
  //   { "pattern": "openax.ai", "custom_domain": true },
  //   { "pattern": "www.openax.ai", "custom_domain": true }
  // ],
  //
  // Both hosts should be deployed. dist/_redirects (generated from SITE_URL)
  // 301s www -> apex at the edge, with no Worker invocation.
  //
  // Dashboard settings that cannot be expressed here:
  //   SSL/TLS ........... Full (strict)
  //   Always Use HTTPS .. on
  //   HTTP/3 ............ on
  //   Early Hints ....... on  (replays the Link headers this repo emits)
  //   Brotli ............ on
  //   Tiered Cache ...... on
  //   Rocket Loader ..... OFF (nothing to lazy-load; it fights the preloads)
  //   Auto Minify ....... off for HTML/CSS/JS (already minified at build)
  //
  // Everything that can live in code is in public/_headers: cache-control,
  // CSP, HSTS and the rest.
}
