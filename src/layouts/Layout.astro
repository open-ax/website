---
import Font from 'astro/components/Font.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  robots?: string;
  preloadLogo?: boolean;
}

const {
  title = 'OpenAX — The Web for Agents',
  description = 'OpenAX flips the web for agents: pages list the tools they offer via WebMCP and the browser runs the calls locally. No screenshots, no guessing.',
  robots = 'index, follow',
  preloadLogo = false,
} = Astro.props;

const site = Astro.site?.href.replace(/\/$/, '');
const abs = (path: string) => (site ? `${site}${path}` : path);
const canonical = site ? `${site}/` : undefined;
const ogImage = abs('/og-image.png');

// Keep in sync with `.logo` in global.css. Without imagesrcset/imagesizes, a
// high-DPR display preloads the 1x file and then fetches the 2x file it renders.
const LOGO_SIZES = '(min-width: 640px) 40px, 36px';

const org: Record<string, unknown> = {
  '@type': 'Organization',
  '@id': '#organization',
  name: 'OpenAX',
  description:
    'OpenAX flips the web for agents: pages list the tools they offer via WebMCP and the browser runs the calls locally.',
  email: 'contactopenax@gmail.com',
  sameAs: ['https://github.com/open-ax', 'https://x.com/getaxkit'],
};

const website: Record<string, unknown> = {
  '@type': 'WebSite',
  '@id': '#website',
  name: 'OpenAX',
  description: org.description,
  inLanguage: 'en',
};

const webpage: Record<string, unknown> = {
  '@type': 'WebPage',
  '@id': '#webpage',
  name: title,
  description,
  inLanguage: 'en',
};

if (site) {
  org.url = `${site}/`;
  org.logo = abs('/og-image.png');
  website.url = `${site}/`;
  website.publisher = { '@id': `${site}/#organization` };
  webpage.url = `${site}/`;
  webpage.isPartOf = { '@id': `${site}/#website` };
  webpage.about = { '@id': `${site}/#organization` };
  for (const node of [org, website, webpage]) {
    const rel = node['@id'] as string;
    node['@id'] = `${site}/${rel}`;
  }
}

const graph = { '@context': 'https://schema.org', '@graph': [org, website, webpage] };

const googleVerification = import.meta.env.GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.BING_SITE_VERIFICATION;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content="OpenAX" />
    <meta name="theme-color" content="#FAFAFA" />
    <meta name="color-scheme" content="light" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OpenAX" />
    <meta property="og:locale" content="en_US" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="OpenAX" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@getaxkit" />
    <meta name="twitter:creator" content="@getaxkit" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="OpenAX" />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {
      preloadLogo && (
        <link
          rel="preload"
          as="image"
          href="/logo-64.webp"
          imagesrcset="/logo-64.webp 1x, /logo-96.webp 2x"
          imagesizes={LOGO_SIZES}
          type="image/webp"
          fetchpriority="high"
        />
      )
    }
    <Font cssVariable="--font-sans" preload />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <slot />
  </body>
</html>
