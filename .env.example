# Absolute origin for the deployed site, no trailing slash.
#
# This is the single source of truth for:
#   - <link rel="canonical">, og:url, og:image, twitter:image
#   - the JSON-LD Organization url + logo
#   - /sitemap.xml and the Sitemap: line in /robots.txt
#   - the www -> apex 301 in dist/_redirects
#
# Everything downstream is generated from it, so nothing can drift. Copy this
# file to `.env` (git-ignored) and fill in the real domain.
#
# Leave it unset for local work: the build still succeeds and just omits the
# absolute URLs. `npm run verify` will warn, and `npm run deploy` refuses to
# publish without it.
SITE_URL=https://openax.ai
